# Standaardapplicaties voor de Hyprland-desktopopzet.
#
# install.sh voegt deze regels samen met ~/.config/mimeapps.list: de hier
# genoemde typen krijgen de opgegeven app, eigen extra koppelingen (zoals
# URL-schema's) blijven bewaard. Pas je iets aan? Draai daarna
# ~/.config/hypr/scripts/apply-default-apps.sh of opnieuw ./install.sh.
#
# De KDE-servicecache wordt met XDG_MENU_PREFIX=plasma- opgebouwd; zie
# hyprland.conf. Zonder die prefix vindt Dolphin geen standaardapps.

[Default Applications]

# Web
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop

# Eigen scheme-handlers (bestaand)
x-scheme-handler/flywheel-local=Local.desktop
x-scheme-handler/opencode=OpenCode-handler.desktop
x-scheme-handler/openwhispr=open-whispr.desktop
x-scheme-handler/ytmd=youtube-music-desktop-app.desktop

# Bestandsbeheer
inode/directory=org.kde.dolphin.desktop

# Tekst, code en configuratie
